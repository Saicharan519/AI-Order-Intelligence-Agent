# Copy to .env and fill in values. .env is git-ignored; never commit it.
# Use a different random password for every database role.

# --- PostgreSQL (Docker) ---
POSTGRES_DB=orderintel
POSTGRES_PORT=5432
# Bootstrap superuser, used only to create roles in migrations (M2)
POSTGRES_PASSWORD=
# Role passwords (roles are created in M2)
OI_OWNER_PASSWORD=
OI_AGENT_PASSWORD=
OI_TRACE_PASSWORD=
OI_EVAL_PASSWORD=
OI_INJTEST_PASSWORD=

# --- LLM provider (DeepSeek, OpenAI-compatible) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL_PRIMARY=deepseek-flash
LLM_MODEL_COMPARISON=deepseek-v4-pro

# --- Budget caps (USD); hard limits enforced in code ---
LLM_TOTAL_CAP_USD=1.90
LLM_DAILY_CAP_USD=0.40

# --- API / demo ---
ACCESS_CODE=
