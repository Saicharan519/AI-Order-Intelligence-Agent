# Copy to .env and fill in values. .env is git-ignored; never commit it.
# Use a different random password for every database role.

# --- PostgreSQL (Docker) ---
POSTGRES_DB=orderintel
POSTGRES_PORT=5432
# Bootstrap superuser, used only to create roles in migrations (M2)
POSTGRES_PASSWORD=
# Role passwords (roles are created in M2)
OI_OWNER_PASSWORD=
OI_AGENT_PASSWORD=
OI_TRACE_PASSWORD=
OI_EVAL_PASSWORD=
OI_INJTEST_PASSWORD=

# --- LLM provider (Google Gemini API, free tier, OpenAI-compatible endpoint) ---
# Create the key in Google AI Studio in a project WITHOUT billing enabled.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL_PRIMARY=gemini-3.5-flash-lite
LLM_MODEL_COMPARISON=gemini-3.8-flash

# --- Quota caps, enforced in code; keep them BELOW the free-tier limits shown in AI Studio ---
# Provisional values until M0b records the project's real limits.
LLM_MAX_RPM=10
LLM_MAX_REQUESTS_PER_DAY=200
LLM_MAX_TOKENS_PER_DAY=1000000

# --- API / demo ---
ACCESS_CODE=
