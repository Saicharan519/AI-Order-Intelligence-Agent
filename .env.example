# Copy to .env and fill in values. .env is git-ignored; never commit it.
# Use a different random password for every database role.

# --- PostgreSQL (Docker) ---
POSTGRES_DB=orderintel
POSTGRES_PORT=5432
# Bootstrap superuser, used only to create roles in migrations (M2)
POSTGRES_PASSWORD=
# Role passwords (roles are created in M2)
OI_OWNER_PASSWORD=
OI_AGENT_PASSWORD=
OI_TRACE_PASSWORD=
OI_EVAL_PASSWORD=
OI_INJTEST_PASSWORD=

# --- Active LLM provider: deepseek (primary) or gemini (comparison only) ---
LLM_PROVIDER=deepseek

# --- DeepSeek (primary, paid, OpenAI-compatible) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_PRIMARY=deepseek-flash
DEEPSEEK_MODEL_COMPARISON=deepseek-v4-pro

# --- Budget caps (USD) for DeepSeek; hard limits enforced in code ---
LLM_TOTAL_CAP_USD=1.90
LLM_DAILY_CAP_USD=0.40

# --- Gemini (optional second provider, free tier, OpenAI-compatible endpoint) ---
# Create the key in Google AI Studio in a project WITHOUT billing enabled.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.5-flash-lite
# Free tier for gemini-3.5-flash-lite (AI Studio, 2026-10-16): 15 RPM, 250K input TPM, 500 RPD.
# Caps are about 80-90% of those limits. Daily quota resets at midnight Pacific time.
GEMINI_MAX_RPM=12
GEMINI_MAX_REQUESTS_PER_DAY=450
GEMINI_MAX_INPUT_TPM=200000

# --- API / demo ---
ACCESS_CODE=
# Requests per minute, per client IP and in total (in-memory token buckets).
RATE_LIMIT_PER_IP_PER_MIN=10
RATE_LIMIT_GLOBAL_PER_MIN=60
# Kill switch: false makes the API refuse every question that needs the model.
LLM_ENABLED=true
# Where the Streamlit UI finds the API.
API_URL=http://127.0.0.1:8000

# --- Email: sign-in codes, password reset, email change, invites ---
# console = print each email in the API's terminal (development, nothing is sent)
# smtp    = really send it, e.g. through your Gmail:
#   1. Google Account > Security > turn on 2-Step Verification
#   2. Google Account > Security > App passwords > create one named "Order Intelligence"
#   3. SMTP_USER = your Gmail address, SMTP_PASSWORD = that 16-character App Password
#      (never your real Gmail password; delete the App Password to stop sending at once)
# off     = send nothing (then set LOGIN_CODE_REQUIRED=false, or nobody can sign in)
MAIL_MODE=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=Order Intelligence
# A 6-digit emailed code after the password ("trust this device" skips it for 30 days).
LOGIN_CODE_REQUIRED=true
# The web app's address, for the links in invite emails.
APP_URL=http://localhost:3000

# --- Deployment (server only; see docs/deploy.md) ---
# The public name Caddy gets an HTTPS certificate for, e.g. orderintel.duckdns.org.
# On a laptop, leave it unset: the rehearsal serves https://localhost.
SITE_ADDRESS=
